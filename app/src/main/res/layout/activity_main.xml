<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101317"
    android:fillViewport="true"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Üst Başlık ve Master Power -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="PRO DSP VOLUME EQ"
                android:textColor="#00E676"
                android:textSize="19sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

            <Switch
                android:id="@+id/switchEqEnable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="DSP AKTİF "
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Segmentli Stereo LED VU Metre -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1A1E24"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STEREO PEAK VU METER (L / R)"
                android:textColor="#9E9E9E"
                android:textSize="11sp"
                android:layout_marginBottom="6dp"/>

            <com.custom.musicvolumeeq.LedVuMeterView
                android:id="@+id/ledVuMeter"
                android:layout_width="match_parent"
                android:layout_height="52dp" />
        </LinearLayout>

        <!-- Yuvarlak Potansiyometreler (Volume, Preamp, Bass, 3D, Balance) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1A1E24"
            android:orientation="vertical"
            android:padding="10dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="135dp"
                android:orientation="horizontal">

                <com.custom.musicvolumeeq.RotaryKnobView
                    android:id="@+id/knobVolume"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <com.custom.musicvolumeeq.RotaryKnobView
                    android:id="@+id/knobPreamp"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="135dp"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <com.custom.musicvolumeeq.RotaryKnobView
                    android:id="@+id/knobBass"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <com.custom.musicvolumeeq.RotaryKnobView
                    android:id="@+id/knobVirtualizer"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />
            </LinearLayout>

            <!-- Yeni Eklenen Sol/Sağ Balans Potu -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="135dp"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <com.custom.musicvolumeeq.RotaryKnobView
                    android:id="@+id/knobBalance"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>

        <!-- Hızlı Filtre Modları ve Hazır Profiller -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1A1E24"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ÖZEL KESİCİ FİLTRELER &amp; PROFİLLER"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btnVoiceFilter"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="SSB / VOKAL (300Hz-3kHz)"
                    android:textSize="10sp"
                    android:backgroundTint="#2E3646"
                    android:textColor="#00E676"
                    android:layout_marginEnd="4dp"/>

                <Button
                    android:id="@+id/btnSubBassCut"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="HPF (UĞULTU KESİCİ)"
                    android:textSize="10sp"
                    android:backgroundTint="#2E3646"
                    android:textColor="#FFEB3B"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Spinner
                    android:id="@+id/spinnerPresets"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:background="#262B34" />

                <Button
                    android:id="@+id/btnFlat"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="#37474F"
                    android:text="FLAT (0 dB)"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Dinamik Ekolayzır Bantları -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1A1E24"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GRAFİK EKOLAYZIR BANTLARI"
                android:textColor="#00E676"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/eqBandsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
